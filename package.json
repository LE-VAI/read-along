{
  "name": "@designesy/read-along",
  "version": "0.3.0",
  "description": "Embeddable bimodal read-along web component: karaoke-sync word highlighting with pluggable TTS engines (Web Speech, pre-synthesized audio, an opt-in local neural voice, or your own), spoken-text pronunciation fixes, and a CLI that verifies pronunciation by transcribing the voice back.",
  "type": "module",
  "main": "src/read-along.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/read-along.js"
    },
    "./read-along.css": "./src/read-along.css",
    "./timings.js": "./src/timings.js",
    "./engines/webspeech.js": "./src/engines/webspeech.js",
    "./engines/media.js": "./src/engines/media.js",
    "./engines/kokoro.js": "./src/engines/kokoro.js",
    "./engines/external.js": "./src/engines/external.js",
    "./styles.js": "./src/styles.js",
    "./tokenizer.js": "./src/tokenizer.js",
    "./pronunciations.js": "./src/pronunciations.js"
  },
  "bin": {
    "read-along-verify": "bin/read-along-verify.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/tokenizer.test.mjs tests/announce.test.mjs tests/webspeech.test.mjs tests/external.test.mjs tests/media.test.mjs tests/highlight.test.mjs tests/kokoro.test.mjs tests/pronunciations.test.mjs tests/natural-voice.test.mjs tests/verify.test.mjs"
  },
  "keywords": [
    "read-along",
    "read-aloud",
    "tts",
    "text-to-speech",
    "accessibility",
    "a11y",
    "bimodal",
    "karaoke",
    "highlight",
    "dyslexia",
    "web-components",
    "screen-reader",
    "pronunciation"
  ],
  "license": "MIT",
  "author": {
    "name": "Designesy",
    "email": "hello@designesy.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LE-VAI/read-along.git"
  },
  "bugs": {
    "url": "https://github.com/LE-VAI/read-along/issues"
  },
  "homepage": "https://github.com/LE-VAI/read-along#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./src/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "@huggingface/transformers": "^3.5.1 || ^4.0.0",
    "kokoro-js": "^1.2.1"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    },
    "kokoro-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "kokoro-js": "^1.2.1"
  }
}
